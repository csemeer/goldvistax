# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Market-Data Configuration
MARKET_DATA_PRIMARY_PROVIDER="yahoo_finance"
MARKET_DATA_FALLBACK_PROVIDER="simulated_reference"
MARKET_DATA_MAX_STALE_SECONDS=60
MARKET_DATA_POLL_INTERVAL_SECONDS=15

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Multi-Channel Webhooks (Optional)
WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Enterprise Billing & Webhook Security (Required before Production)
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET"
AURUM_BILLING_STORE_PATH="/tmp/aurum-billing-store.json"

# Automated EIA Petroleum & St. Louis FRED DFII10 Feeds (Optional — public CSV / curated fallbacks active when absent)
EIA_API_KEY="YOUR_EIA_API_KEY"
FRED_API_KEY="YOUR_FRED_API_KEY"

# Server-Side HMAC Session Signing & Production Persona Guard (§6.1-6.2)
AURUM_SESSION_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_IN_PRODUCTION"
ALLOW_SANDBOX_PERSONAS="false"

# Optional External OIDC / OAuth 2.0 PKCE JWKS Verification (GAP-07 Cutover)
OAUTH_JWKS_URI="https://your-idp.example.com/.well-known/jwks.json"
OAUTH_ISSUER="https://your-idp.example.com/"
OAUTH_AUDIENCE="goldvista-api"
OAUTH_AUTHORIZATION_ENDPOINT="https://your-idp.example.com/authorize"
OAUTH_TOKEN_ENDPOINT="https://your-idp.example.com/oauth/token"
OAUTH_CLIENT_ID="goldvista-web-pkce"
OAUTH_REDIRECT_URI="https://app.goldvista.io/auth/callback"

# Transactional PostgreSQL, Auto-Migrations & Strict Edge Origin Allowlist (Required for Production Wave A/C)
DATABASE_URL="postgres://user:password@localhost:5432/goldvista"
RUN_MIGRATIONS_ON_BOOT="true"
AURUM_JOURNAL_STORE_PATH="/tmp/aurum-journal-store.json"
ALLOWED_ORIGINS="https://app.goldvista.io,http://localhost:3000"
